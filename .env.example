# docker compose / 로컬 실행용 환경변수 예시. 복사해서 .env 로 쓴다 (.env 는 git 에 올리지 않는다).
FORESIGHT_BACKEND=onnx                      # onnx | onnx-int8 | torch
FORESIGHT_CKPT=results/checkpoints/eth/seed0/best.pth
FORESIGHT_ONNX_DIR=artifacts/onnx
MLFLOW_TRACKING_URI=sqlite:///mlflow.db     # compose 에서는 http://mlflow:5000
# MinIO (S3 호환) — DVC 원격·MLflow 아티팩트. AWS 를 쓰면 endpoint 를 비우고 실제 키를 넣는다.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=ap-northeast-2
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
# Kafka / Redpanda
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=rtls.positions
KAFKA_ALERTS_TOPIC=rtls.alerts
