{
 "title": "rtls-foresight API",
 "uid": "rtls-foresight",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "refresh": "10s",
 "tags": [
  "rtls-foresight"
 ],
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "요청 처리 지연 /risk (p50 · p95 · p99)",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum(rate(foresight_request_latency_seconds_bucket{endpoint=\"/risk\"}[1m])) by (le))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum(rate(foresight_request_latency_seconds_bucket{endpoint=\"/risk\"}[1m])) by (le))",
     "legendFormat": "p95"
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.99, sum(rate(foresight_request_latency_seconds_bucket{endpoint=\"/risk\"}[1m])) by (le))",
     "legendFormat": "p99"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "요청 수 / s (엔드포인트·상태)",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(foresight_requests_total[1m])) by (endpoint, status)",
     "legendFormat": "{{endpoint}} {{status}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "예측한 에이전트 수 / s",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(foresight_predictions_total[1m])) by (endpoint)",
     "legendFormat": "{{endpoint}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "임계 초과 쌍(경보) / 시간 환산",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(foresight_alerts_total[5m])) * 3600",
     "legendFormat": "alerts/h"
    }
   ]
  },
  {
   "id": 5,
   "type": "bargauge",
   "title": "요청당 에이전트 수 분포",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(foresight_agents_per_request_bucket[5m])) by (le)",
     "legendFormat": "{{le}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "비 2xx 비율",
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(foresight_requests_total{status!~\"2..\"}[5m])) / sum(rate(foresight_requests_total[5m]))",
     "legendFormat": "error ratio"
    }
   ]
  }
 ]
}